# server.js configuration — copy to .env and export, or pass inline.
#
#   OLLAMA_URL=http://10.0.0.12:11434 PORT=8080 node server.js

PORT=8080
HOST=0.0.0.0

# Where the same-origin proxy forwards /gateway/*.
#   Same host:       http://127.0.0.1:11434
#   docker compose:  http://ollama:11434
#   Private subnet:  http://10.0.0.12:11434   (VCN-internal, never a public IP)
OLLAMA_URL=http://127.0.0.1:11434

GATEWAY_PREFIX=/gateway/

# OpenAI-compatible runtimes work through the same proxy: point OLLAMA_URL at
# vLLM (:8000), TGI or LiteLLM and pick the matching preset in the workspace.
# The proxy is path-agnostic — it forwards /gateway/<path> to <target>/<path>.
