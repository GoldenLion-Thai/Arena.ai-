# =============================================================================
# GRiD-OS-SOVEREIGN — nginx edge template
#
# deploy/install.sh renders this into /etc/nginx/sites-available/grid-os-sovereign.conf
# (or /etc/nginx/conf.d/… on RHEL-family) substituting:
#
#   {{DOMAIN}} {{ROOT}} {{APP_PORT}} {{OLLAMA_PORT}} {{TLS_CERT}} {{TLS_KEY}}
#   {{SECURITY}}      → basic-auth and/or IP-allowlist directives (may be empty)
#   {{#TLS}} … {{/TLS}}      kept when TLS is on
#   {{^TLS}} … {{^/TLS}}     kept when TLS is off (plain HTTP site)
#
# Hand-editing is fine: replace the tokens yourself and drop the section you
# don't want. The two settings that break token streaming are buffering and
# short read timeouts — if you change nothing else, keep `proxy_buffering off`
# and the 600s read timeout.
# =============================================================================

# The model host is addressed directly, so the node proxy is optional. Both are
# declared; nginx only connects to the one a location actually uses.
upstream grid_app {
    server 127.0.0.1:{{APP_PORT}};   # node server.js (static UI + /gateway proxy)
    keepalive 32;
}

upstream ollama_backend {
    server 127.0.0.1:{{OLLAMA_PORT}};  # loopback only — never a public address
    keepalive 16;
}

{{#TLS}}
server {
    listen 443 ssl;
    http2 on;
    server_name {{DOMAIN}};

    ssl_certificate     {{TLS_CERT}};
    ssl_certificate_key {{TLS_KEY}};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'" always;

{{SECURITY}}

    client_max_body_size 200m;   # document uploads

    root {{ROOT}};
    index index.html;

    location / {
        try_files $uri $uri.html $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    # Model gateway — token streaming must never be buffered.
    location /gateway/ {
        proxy_pass http://ollama_backend/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        gzip off;

        proxy_connect_timeout 10s;
        proxy_send_timeout    600s;
        proxy_read_timeout    600s;   # long generations, slow reasoning models
        add_header X-Accel-Buffering no;
    }

    # Health endpoint for load balancers and uptime checks.
    location = /healthz {
        proxy_pass http://grid_app/healthz;
        access_log off;
    }
}

server {
    listen 80;
    server_name {{DOMAIN}};
    # Let's Encrypt needs a plain-HTTP path for the challenge.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
{{/TLS}}

{{^TLS}}
# Plain HTTP — staging, an internal network, or behind another terminator
# (ALB, Cloudflare, Tailscale Funnel). Add TLS before exposing this publicly.
server {
    listen 80 default_server;
    server_name {{DOMAIN}};

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

{{SECURITY}}

    client_max_body_size 200m;

    root {{ROOT}};
    index index.html;

    location / {
        try_files $uri $uri.html $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    location /gateway/ {
        proxy_pass http://ollama_backend/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        gzip off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        add_header X-Accel-Buffering no;
    }

    location = /healthz {
        proxy_pass http://grid_app/healthz;
        access_log off;
    }
}
{{^/TLS}}
