# systemd drop-in for the Ollama host.
# Install as:  /etc/systemd/system/ollama.service.d/override.conf
#   sudo systemctl daemon-reload && sudo systemctl restart ollama
#
# OLLAMA_HOST stays on loopback: the app tier publishes the model, the network
# never does. OLLAMA_ORIGINS is only needed when a browser calls Ollama
# directly — which is exactly what the same-origin proxy exists to avoid.

[Service]
Environment="OLLAMA_HOST=127.0.0.1:11434"
Environment="OLLAMA_KEEP_ALIVE=30m"
Environment="OLLAMA_NUM_PARALLEL=4"
Environment="OLLAMA_MAX_LOADED_MODELS=2"
Environment="OLLAMA_FLASH_ATTENTION=1"
Environment="OLLAMA_KV_CACHE_TYPE=q8_0"
Environment="OLLAMA_MODELS=/var/lib/ollama/models"

# Direct-browser deployments only — list the exact origins you serve:
# Environment="OLLAMA_ORIGINS=https://llm.yourdomain.co.uk"

# Hardening: the model host has no reason to write elsewhere or spawn shells.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
RestrictSUIDSGID=true
